<Window x:Class="CabinetOftalmoWPF.IstoricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Istoric Pacient" Height="450" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtNumePacient" Text="Istoric modificări pentru: " FontSize="18" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,15"/>

        <DataGrid x:Name="TabelIstoric" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" FontSize="14" AlternatingRowBackground="#F5F5F5" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DataInregistrare}" Width="1.2*"/>
                <DataGridTextColumn Header="Ramă" Binding="{Binding Rama}" Width="*"/>
                <DataGridTextColumn Header="Tip Lentilă" Binding="{Binding TipLentila}" Width="*"/>
                <DataGridTextColumn Header="Dioptrii" Binding="{Binding Dioptrii}" Width="1.5*"/>
                <DataGridTextColumn Header="Observații" Binding="{Binding Observatii}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>