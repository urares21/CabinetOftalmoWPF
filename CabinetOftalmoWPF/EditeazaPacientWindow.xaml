<Window x:Class="CabinetOftalmoWPF.EditeazaPacientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editează Pacient" Height="650" Width="420" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nume Complet:" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtNume" Grid.Row="1" Margin="0,0,0,15" Padding="5" FontSize="14"/>

        <TextBlock Text="Telefon:" FontWeight="Bold" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtTelefon" Grid.Row="3" Margin="0,0,0,15" Padding="5" FontSize="14"/>

        <TextBlock Text="Email (opțional):" FontWeight="Bold" Grid.Row="4" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtEmail" Grid.Row="5" Margin="0,0,0,15" Padding="5" FontSize="14"/>

        <TextBlock Text="Ramă:" FontWeight="Bold" Grid.Row="6" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtRama" Grid.Row="7" Margin="0,0,0,15" Padding="5" FontSize="14"/>

        <TextBlock Text="Tip Lentilă:" FontWeight="Bold" Grid.Row="8" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtTipLentila" Grid.Row="9" Margin="0,0,0,15" Padding="5" FontSize="14"/>

        <TextBlock Text="Dioptrii:" FontWeight="Bold" Grid.Row="10" Margin="0,0,0,5"/>
        <Grid Grid.Row="11" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="OD:" FontWeight="Bold" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#1976D2"/>
            <TextBox x:Name="TxtOD" Grid.Column="1" Padding="5" FontSize="14" Margin="0,0,15,0"/>
            <TextBlock Text="OS:" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#1976D2"/>
            <TextBox x:Name="TxtOS" Grid.Column="3" Padding="5" FontSize="14"/>
        </Grid>

        <TextBlock Text="Observații:" FontWeight="Bold" Grid.Row="12" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtObservatii" Grid.Row="13" Margin="0,0,0,15" Padding="5" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

        <Button Content="Actualizează Datele" Grid.Row="14" VerticalAlignment="Bottom" Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="14" Padding="10" BorderThickness="0" Click="BtnActualizeaza_Click"/>
    </Grid>
</Window>